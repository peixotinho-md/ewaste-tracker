# Banco de dados local (recriado a partir de dados/*.json)
backend/etrilha.db
backend/etrilha.db-wal
backend/etrilha.db-shm

# Chave de assinatura do cookie de sessão
backend/.chave-sessao

# Log do servidor
backend/_servidor.log

# Ambientes virtuais e caches do Python
.venv/
__pycache__/

# Saída das ferramentas de teste
.pytest_cache/
.coverage
htmlcov/

# O PDF da Pré-Entrega. O que é versionado é o docs/pre-entrega-1.html que o
# gera — meio megabyte de binário entraria no histórico a cada regeração e
# nunca mais sairia, e o git não sabe mostrar o que mudou entre dois PDFs.
#
#   chrome --headless --no-pdf-header-footer #          --print-to-pdf=docs/PRE-ENTREGA-N.pdf docs/pre-entrega-N.html
docs/PRE-ENTREGA-*.pdf
docs/RELATORIO-TECNICO.pdf

# Capturas de tela soltas na raiz. A barra inicial ancora a regra AQUI: as
# evidências de teste que a Pré-Entrega 3 exige vão para docs/ e continuam
# versionadas — é justamente o material que precisa acompanhar o relatório.
/*.png

# Cópia da versão anterior: o histórico do git já cumpre esse papel
backup/
